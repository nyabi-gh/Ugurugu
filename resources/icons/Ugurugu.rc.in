IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/resources/icons/Ugurugu.ico"

// VS_VERSION_INFO is 1. Spelling the ordinal out keeps this resource free of
// windows.h, which the Qt resource compilation of this file does not include.
1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Nyabi (nyabi-gh)"
            VALUE "FileDescription", "Ugurugu"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "Ugurugu"
            VALUE "LegalCopyright", "Copyright (C) 2026 Nyabi (nyabi-gh). Licensed under GPL-3.0-or-later."
            VALUE "OriginalFilename", "Ugurugu.exe"
            VALUE "ProductName", "Ugurugu"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
