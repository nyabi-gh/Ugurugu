<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>Ugurugu</string>
    <key>CFBundleExecutable</key>
    <string>Ugurugu</string>
    <key>CFBundleIconFile</key>
    <string>Ugurugu.icns</string>
    <key>CFBundleIdentifier</key>
    <string>dev.ugurugu.app</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>Ugurugu</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>@PROJECT_VERSION@</string>
    <key>CFBundleVersion</key>
    <string>@PROJECT_VERSION@</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.graphics-design</string>
    <key>LSMinimumSystemVersion</key>
    <string>@CMAKE_OSX_DEPLOYMENT_TARGET@</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2026 Nyabi (nyabi-gh). Licensed under GPL-3.0-or-later.</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <key>SUFeedURL</key>
    <string>https://github.com/nyabi-gh/Ugurugu/releases/latest/download/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string>mLaqOS+6ecy63XvvlA7/LdNrLJO4fLrSWmy+2B/w2ow=</string>
    <!-- Keep in step with UpdateCheckPolicy::automaticCheckIntervalSeconds,
         which paces the Windows updater. Sparkle owns the schedule here and
         already retries a failed check, so the two platforms only agree if
         this number matches. -->
    <key>SUScheduledCheckInterval</key>
    <integer>21600</integer>
</dict>
</plist>
